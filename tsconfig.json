{
	"compilerOptions": {
		"lib": ["esnext"],
		"target": "esnext",
		"noEmit": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"module": "preserve",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"types": ["bun", "node"],
		"paths": {
			"@/secrets/*": ["./src/secrets/src/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": ["*.d.ts", "src/**/*"],
	"exclude": ["src/web/react/**/*"]
}
