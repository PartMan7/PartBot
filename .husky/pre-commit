#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

bash <<EOF
  set -e
  TO_PRETTIFY="$(git diff --diff-filter=ACMTUXB --name-only --staged | grep -E -e '\.[jt]sx?$' -e '\.md$' -e '\.html$' -e '\.json$' || :)"
  if [[ -n "\$TO_PRETTIFY" ]]; then
    bun run prettify -- \$TO_PRETTIFY
    git add -- \$TO_PRETTIFY
  fi
  bun run test:staged
  FAIL_ON_PENDING=true bun run notify-unpushed -- src/secrets
  bun run secrets-check
EOF
